# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/agrisense

# AI service (Khushboo's FastAPI service)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=8000

# Weather (Open-Meteo — no API key required)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_MS=6000

# Market (Agmarknet-shaped adapter — plug in a real key/URL when available)
MARKET_API_URL=
MARKET_API_KEY=
MARKET_TIMEOUT_MS=6000

# Upload limits
MAX_IMAGE_UPLOAD_BYTES=8388608

# Review / consensus thresholds (documented in README "Consensus rule")
REVIEW_MIN_REVIEWS_FOR_CONSENSUS=2
REVIEW_CONSENSUS_THRESHOLD=0.34
REVIEW_DISAGREEMENT_MIN_MINORITY_FRACTION=0.34
